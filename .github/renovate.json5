{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    ":pinAllExceptPeerDependencies",
    ":automergeMinor",
    ":automergeDigest",
    ":automergeLinters",
    ":automergeTesters",
    "group:nextjsMonorepo",
    "group:nodeJs",
  ],
  pinDigest: { automerge: true },
  postUpdateOptions: ["pnpmDedupe"],
  packageRules: [
    { matchDepTypes: ["packageManager"], automerge: true },
    // The Dockerfile copies pnpm from its image, so it moves with packageManager.
    { matchPackageNames: ["pnpm", "ghcr.io/pnpm/pnpm"], groupName: "pnpm" },
  ],
}
