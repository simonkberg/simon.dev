{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    ":pinAllExceptPeerDependencies",
    ":automergeMinor",
    ":automergeDigest",
    ":automergeLinters",
    ":automergeTesters",
    "group:nextjsMonorepo",
    "group:nodeJs",
  ],
  pinDigest: { automerge: true },
  postUpdateOptions: ["pnpmDedupe"],
  packageRules: [
    { matchDepTypes: ["packageManager"], automerge: true },
    // The Dockerfile copies pnpm from its image, so it moves with packageManager.
    // GHCR has no release dates, so take the newest for both and let npm's age hold the merge.
    // GitHub's automerge would ignore that pending check, so Renovate merges these itself.
    {
      matchPackageNames: ["pnpm", "ghcr.io/pnpm/pnpm"],
      groupName: "pnpm",
      internalChecksFilter: "none",
      platformAutomerge: false,
    },
  ],
}
